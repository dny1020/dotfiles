APP_NAME={{ project_name }}
ENVIRONMENT=development
LOG_LEVEL=INFO
{% if use_database %}
DATABASE_URL={{ 'postgresql+psycopg://postgres:postgres@db:5432/' ~ project_slug if db_engine == 'postgresql' else 'sqlite:///./data/app.db' }}
{% endif %}
{% if use_redis %}
REDIS_URL=redis://redis:6379/0
{% endif %}
{% if use_auth %}
API_KEY=changeme
{% endif %}
