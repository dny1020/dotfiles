[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
{% if author_name %}
authors = [{ name = "{{ author_name }}" }]
{% endif %}
requires-python = ">={{ python_version }}"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.32",
    "pydantic-settings>=2.6",
    "structlog>=24.4",
{% if use_database %}
    "sqlalchemy>=2.0",
    "alembic>=1.13",
{% if db_engine == "postgresql" %}
    "psycopg[binary]>=3.2",
{% else %}
    "aiosqlite>=0.20",
{% endif %}
{% endif %}
{% if use_redis %}
    "redis>=5.2",
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3",
    "pytest-cov>=6.0",
    "httpx>=0.27",
    "ruff>=0.7",
    "pyright>=1.1",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version.replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]
ignore = ["B008"]  # FastAPI's Depends() default-arg pattern is intentional

[tool.pyright]
include = ["app", "tests"]
pythonVersion = "{{ python_version }}"

[tool.pytest.ini_options]
addopts = "--cov=app --cov-report=term-missing"
testpaths = ["tests"]

[tool.uv]
package = false
