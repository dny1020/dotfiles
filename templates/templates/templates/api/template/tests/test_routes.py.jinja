from fastapi.testclient import TestClient
{% if use_auth %}

from app.main import app
{% endif %}


def test_health(client: TestClient) -> None:
    response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}
{% if use_database %}


def test_create_and_get_item(client: TestClient) -> None:
    create_response = client.post("/items", json={"name": "widget"})
    assert create_response.status_code == 201
    item_id = create_response.json()["id"]

    get_response = client.get(f"/items/{item_id}")
    assert get_response.status_code == 200
    assert get_response.json()["name"] == "widget"


def test_get_item_not_found(client: TestClient) -> None:
    response = client.get("/items/999")
    assert response.status_code == 404
{% endif %}
{% if use_auth %}


def test_protected_endpoint_requires_api_key() -> None:
    unauthenticated_client = TestClient(app)
    response = unauthenticated_client.get("{% if use_database %}/items{% else %}/protected{% endif %}")
    assert response.status_code == 401
{% endif %}
