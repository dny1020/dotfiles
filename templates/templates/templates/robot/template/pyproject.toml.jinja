[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
{% if author_name %}
authors = [{ name = "{{ author_name }}" }]
{% endif %}
requires-python = ">={{ python_version }}"
dependencies = [
    "apscheduler>=3.10",
    "httpx>=0.27",
    "sqlalchemy>=2.0",
    "pydantic-settings>=2.6",
    "structlog>=24.4",
{% if use_ml_check %}
    "scikit-learn>=1.5",
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3",
    "pytest-cov>=6.0",
    "ruff>=0.7",
    "pyright>=1.1",
]

[tool.ruff]
line-length = 100
target-version = "py{{ python_version.replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pyright]
include = ["app", "tests"]
pythonVersion = "{{ python_version }}"

[tool.pytest.ini_options]
addopts = "--cov=app --cov-report=term-missing"
testpaths = ["tests"]

[tool.uv]
package = false
