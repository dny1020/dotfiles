import structlog

from app.alerts import send_alert
{% if use_ml_check %}
from app.anomaly import is_anomalous
{% endif %}
from app.database import get_session
from app.models import JobRun
from app.services import perform_check

logger = structlog.get_logger(__name__)


def run_check_job() -> None:
    session = get_session()
    try:
{% if use_ml_check %}
        success, detail, response_time_ms = perform_check()
        session.add(
            JobRun(
                job_name="check",
                success=success,
                detail=detail,
                response_time_ms=response_time_ms if success else None,
            )
        )
        session.commit()
        logger.info("job_run", job="check", success=success, detail=detail)
        if not success:
            send_alert(f"check job failed: {detail}")
        elif is_anomalous(response_time_ms):
            send_alert(f"check response time looks anomalous: {response_time_ms:.1f}ms")
{% else %}
        success, detail = perform_check()
        session.add(JobRun(job_name="check", success=success, detail=detail))
        session.commit()
        logger.info("job_run", job="check", success=success, detail=detail)
        if not success:
            send_alert(f"check job failed: {detail}")
{% endif %}
    except Exception:
        logger.exception("job_crashed", job="check")
        send_alert("check job crashed unexpectedly")
        raise
    finally:
        session.close()
