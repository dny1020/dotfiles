from types import SimpleNamespace

import httpx
import pytest

from app.services import perform_check


def test_perform_check_success(monkeypatch: pytest.MonkeyPatch) -> None:
    def fake_get(url: str, timeout: float) -> SimpleNamespace:
        return SimpleNamespace(status_code=200, raise_for_status=lambda: None)

    monkeypatch.setattr("app.services.httpx.get", fake_get)

{% if use_ml_check %}
    success, detail, response_time_ms = perform_check()

    assert success is True
    assert detail == "status=200"
    assert response_time_ms >= 0
{% else %}
    success, detail = perform_check()

    assert success is True
    assert detail == "status=200"
{% endif %}


def test_perform_check_failure(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr("app.utils.time.sleep", lambda seconds: None)

    def fake_get(url: str, timeout: float) -> SimpleNamespace:
        raise httpx.ConnectError("boom")

    monkeypatch.setattr("app.services.httpx.get", fake_get)

{% if use_ml_check %}
    success, detail, response_time_ms = perform_check()

    assert success is False
    assert "boom" in detail
    assert response_time_ms == 0.0
{% else %}
    success, detail = perform_check()

    assert success is False
    assert "boom" in detail
{% endif %}
