services:
  api:
    build: .
    env_file: .env
    environment:
      LLAMA_BASE_URL: http://host.docker.internal:8080/v1
    ports:
      - "8000:8000"
    volumes:
      - ./logs:/app/logs
{% if use_rag %}
      - ./data:/app/data
{% endif %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
