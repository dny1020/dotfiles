import httpx
from fastapi.testclient import TestClient

from app.clients import get_client
from app.main import app


def test_health(client: TestClient) -> None:
    response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_upstream_status(client: TestClient) -> None:
    response = client.get("/upstream-status")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_upstream_status_returns_502_on_upstream_failure(client: TestClient) -> None:
    def mock_upstream_down(request: httpx.Request) -> httpx.Response:
        return httpx.Response(500)

    failing_client = httpx.Client(
        transport=httpx.MockTransport(mock_upstream_down),
        base_url="http://upstream.test",
    )
    app.dependency_overrides[get_client] = lambda: failing_client

    response = client.get("/upstream-status")

    assert response.status_code == 502
{% if use_auth %}


def test_protected_endpoint_requires_api_key() -> None:
    unauthenticated_client = TestClient(app)
    response = unauthenticated_client.get("/upstream-status")
    assert response.status_code == 401
{% endif %}
