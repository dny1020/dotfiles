{% if use_fuzzy_dedup %}


def fuzzy_deduplicate(df: pd.DataFrame) -> pd.DataFrame:
    """Drop near-duplicate rows based on fuzzy similarity of a text column.

    O(n^2) in the number of rows — fine for small/medium batches. For large
    datasets, block by an exact key first (e.g. first letter) before comparing.
    """
    settings = get_settings()
    column = settings.fuzzy_dedup_column
    if column not in df.columns:
        return df

    seen_values: list[str] = []
    keep_mask: list[bool] = []
    for value in df[column].astype(str):
        is_duplicate = any(
            fuzz.ratio(value, seen) >= settings.fuzzy_dedup_threshold for seen in seen_values
        )
        keep_mask.append(not is_duplicate)
        if not is_duplicate:
            seen_values.append(value)

    return df.loc[np.array(keep_mask, dtype=bool)]
{% endif %}
