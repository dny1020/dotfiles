import pandas as pd

from app.transform import clean


def test_clean_removes_near_duplicate_names() -> None:
    df = pd.DataFrame({"name": ["Acme Inc", "Acme Inc.", "Globex Corp"]})
    result = clean(df)
    assert len(result) == 2


def test_clean_keeps_distinct_names() -> None:
    df = pd.DataFrame({"name": ["Acme Inc", "Globex Corp", "Initech"]})
    result = clean(df)
    assert len(result) == 3


def test_clean_ignores_fuzzy_dedup_without_matching_column() -> None:
    df = pd.DataFrame({"other_column": ["a", "a", "b"]})
    result = clean(df)
    assert len(result) == 2
