{% if destination == "postgresql" %}
import pandas as pd
import pytest
from sqlalchemy import create_engine
{% else %}
import duckdb
import pandas as pd
import pytest
{% endif %}

from app.load import save


{% if destination == "postgresql" %}
def test_save_creates_table() -> None:
    engine = create_engine("sqlite:///:memory:")
    df = pd.DataFrame({"a": [1, 2, 3]})

    save(engine, df, table_name="test_table")

    with engine.connect() as conn:
        result = conn.exec_driver_sql("SELECT COUNT(*) FROM test_table").scalar()
    assert result == 3
{% else %}
def test_save_creates_table() -> None:
    con = duckdb.connect(":memory:")
    df = pd.DataFrame({"a": [1, 2, 3]})

    save(con, df, table_name="test_table")

    result = con.execute("SELECT COUNT(*) FROM test_table").fetchone()
    assert result is not None
    assert result[0] == 3
{% endif %}


