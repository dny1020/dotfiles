from fastapi.testclient import TestClient
{% if use_auth %}

from app.main import app
{% endif %}


def test_health(client: TestClient) -> None:
    response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_voice_returns_audio_and_transcript(client: TestClient) -> None:
    response = client.post(
        "/voice",
        files={"file": ("input.wav", b"fake-input-audio", "audio/wav")},
    )
    assert response.status_code == 200
    assert response.headers["x-transcript"] == "transcribed text"
    assert response.content == b"FAKE-WAV-BYTES"
{% if use_auth %}


def test_voice_requires_api_key() -> None:
    unauthenticated_client = TestClient(app)
    response = unauthenticated_client.post(
        "/voice",
        files={"file": ("input.wav", b"x", "audio/wav")},
    )
    assert response.status_code == 401
{% endif %}
