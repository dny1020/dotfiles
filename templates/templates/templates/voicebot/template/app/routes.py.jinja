from fastapi import APIRouter, Depends, Response, UploadFile

{% if use_auth %}
from app.auth import require_api_key
{% endif %}
from app.schemas import HealthResponse
from app.speech import VoicePipeline, get_pipeline

public_router = APIRouter()
{% if use_auth %}
router = APIRouter(dependencies=[Depends(require_api_key)])
{% else %}
router = APIRouter()
{% endif %}


@public_router.get("/health", response_model=HealthResponse)
def health() -> HealthResponse:
    return HealthResponse()


@router.post("/voice")
async def voice(file: UploadFile, pipeline: VoicePipeline = Depends(get_pipeline)) -> Response:
    audio_bytes = await file.read()
    transcript, reply_audio = pipeline.handle(audio_bytes)
    return Response(
        content=reply_audio,
        media_type="audio/wav",
        headers={"X-Transcript": transcript},
    )
