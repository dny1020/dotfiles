from app.nlp import extract_entities, fuzzy_match


def test_extract_entities_finds_known_entity() -> None:
    entities = extract_entities("I live in Paris.")
    assert any(ent["text"] == "Paris" for ent in entities)


def test_fuzzy_match_finds_close_match() -> None:
    result = fuzzy_match("bogot", ["Bogota", "Medellin", "Cali"])
    assert result == "Bogota"


def test_fuzzy_match_returns_none_for_bad_match() -> None:
    result = fuzzy_match("xyz123", ["Bogota", "Medellin", "Cali"])
    assert result is None
