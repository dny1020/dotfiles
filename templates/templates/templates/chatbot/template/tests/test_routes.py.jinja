from fastapi.testclient import TestClient
{% if use_auth %}

from app.main import app
{% endif %}


def test_health(client: TestClient) -> None:
    response = client.get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


def test_chat_remembers_session_history(client: TestClient) -> None:
    first = client.post("/chat", json={"session_id": "s1", "message": "hi"})
    assert first.status_code == 200
    assert first.json() == {"reply": "reply-1"}

    second = client.post("/chat", json={"session_id": "s1", "message": "again"})
    assert second.status_code == 200
    assert second.json() == {"reply": "reply-3"}


def test_chat_keeps_sessions_isolated(client: TestClient) -> None:
    client.post("/chat", json={"session_id": "s1", "message": "hi"})
    response = client.post("/chat", json={"session_id": "s2", "message": "hi"})
    assert response.json() == {"reply": "reply-1"}
{% if use_auth %}


def test_chat_requires_api_key() -> None:
    unauthenticated_client = TestClient(app)
    response = unauthenticated_client.post("/chat", json={"session_id": "s1", "message": "hi"})
    assert response.status_code == 401
{% endif %}
