from functools import lru_cache
from typing import Any

from langchain_core.tools import tool
from langchain_openai import ChatOpenAI
from langgraph.prebuilt import create_react_agent

from app.config import get_settings
{% if use_rag %}
from app.embeddings import embed
{% endif %}
{% if use_nlp %}
from app.nlp import extract_entities
{% endif %}
from app.prompts import SYSTEM_PROMPT
from app.tools import get_current_time
{% if use_rag %}
from app.vectorstore import get_collection


def search_knowledge(query: str) -> str:
    """Search the local knowledge base for context relevant to the query."""
    collection = get_collection()
    query_embedding = embed([query])[0]
    result = collection.query(query_embeddings=[query_embedding], n_results=3)
    matches = (result.get("documents") or [[]])[0]
    if not matches:
        return "No relevant documents found."
    return "\n\n".join(matches)
{% endif %}


@lru_cache
def get_agent() -> Any:
    settings = get_settings()
    model = ChatOpenAI(
        model=settings.llama_model,
        base_url=settings.llama_base_url,
        api_key=settings.llama_api_key,
    )

    agent_tools = [tool(get_current_time)]
{% if use_rag %}
    agent_tools.append(tool(search_knowledge))
{% endif %}
{% if use_nlp %}
    agent_tools.append(tool(extract_entities))
{% endif %}

    return create_react_agent(model, tools=agent_tools, prompt=SYSTEM_PROMPT)
