from functools import lru_cache

import spacy
from rapidfuzz import process


@lru_cache
def _get_nlp() -> spacy.language.Language:
    return spacy.load("en_core_web_sm")


def extract_entities(text: str) -> list[dict[str, str]]:
    """Extract named entities (people, places, organizations, etc.) from text."""
    doc = _get_nlp()(text)
    return [{"text": ent.text, "label": ent.label_} for ent in doc.ents]


def fuzzy_match(query: str, choices: list[str], min_score: float = 70.0) -> str | None:
    """Return the closest match to `query` among `choices`, or None if no good match."""
    result = process.extractOne(query, choices)
    if result is None:
        return None
    match, score, _ = result
    return match if score >= min_score else None
