{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": ["~/.claude/AGENTS.md", "~/.claude/skills-index.md"],
  "logLevel": "INFO",

  "mcp": {
    "doction": {
      "type": "remote",
      "url": "https://doction.danilocloud.me/api/mcp",
      "headers": {
        "Authorization": "Bearer {env:DOCTION_MCP_TOKEN}"
      }
    }
  },

  "agent": {
    "build": {
      "permission": {
        "task": "deny"
      }
    }
  }
}
