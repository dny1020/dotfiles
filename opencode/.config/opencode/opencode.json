{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3-4b",
  "default_agent": "build",
  "instructions": ["../../.opencode/AGENTS.md"],
  "logLevel": "INFO",

  "mcp": {
    "doction": {
      "type": "remote",
      "url": "https://doction.danilocloud.me/api/mcp",
      "headers": {
        "Authorization": "Bearer {env:DOCTION_MCP_TOKEN}"
      }
    }
  },

  "agent": {
    "build": {
      "permission": {
        "task": "deny"
      }
    }
  },

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3-4b": {
          "name": "Qwen3 4B (llama.cpp)",
          "tools": true,
          "limit": { "context": 16384, "output": 4096 }
        }
      }
    }
  }
}
