# Local secrets and machine-specific overrides
.claude/settings.local.json
**/.zsh_secrets
**/.zshrc.local

# vim undo/swap files
*.un~
*.swp

# config backups (config.bak.YYYYMMDD-HHMMSS, etc.)
*.bak
*.bak.*

# OS junk
.DS_Store

# systemd `systemctl --user enable` artifacts (machine-specific symlinks created
# inside the stowed unit dir; the unit files themselves stay versioned)
**/systemd/user/*.wants/

# herdr runtime state (logs, sessions, plugin lock)
herdr/.config/herdr/*.log
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/
