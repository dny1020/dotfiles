#!/usr/bin/env bash
# Runs the project's check gate (see ~/.claude/AGENTS.md) without stopping at the first failure.
set -uo pipefail
failed=()

run() {
    printf '\n==> %s\n' "$*"
    "$@" || failed+=("$*")
}

if [ ! -f pyproject.toml ] && [ ! -f package.json ] && [ ! -f setup_debian.sh ]; then
    echo "verify: no hay una configuración de comprobaciones en $PWD" >&2
    exit 2
fi

if [ -f setup_debian.sh ]; then
    run bash -n setup_debian.sh setup_environment.sh tests/setup_environment_test.sh
    run bash tests/setup_environment_test.sh
    run zsh -n zsh/.zshrc
    run git diff --check
fi

if [ -f pyproject.toml ]; then
    run uv run ruff check .
    run uv run ruff format --check .
    run uv run pytest -q
fi

if [ -f package.json ]; then
    run npm run lint
    run npm run format:check
    run npm run build
    run npm run test --if-present -- --run
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
    echo "✓ VERIFY PASSED"
    exit 0
fi
printf '✗ FAILED: %s\n' "${failed[@]}"
exit 1
