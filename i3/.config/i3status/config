# ~/.config/i3status/config — themed (Gruvbox dark + amarillo opaco), acorde a rofi/barra.
# Mismos módulos que el default de Debian; SOLO cambian los colores.
# i3status lo lee automáticamente desde aquí (XDG), antes que /etc/i3status.conf.

general {
        colors = true
        interval = 5
        color_good     = "#d79921"   # normal/ok  -> amarillo opaco (como el workspace activo)
        color_degraded = "#fe8019"   # aviso      -> naranja
        color_bad      = "#cc241d"   # crítico    -> rojo
}

order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}
