# ~/.config/i3status/config — Gruvbox dark + amarillo opaco, acorde a rofi/barra.
# Iconos Material Design de JetBrainsMono Nerd Font. El separador "·" lo pinta i3bar.

general {
        colors = true
        interval = 5
        color_good     = "#d79921"   # normal/ok  -> amarillo opaco (como el workspace activo)
        color_degraded = "#fe8019"   # aviso      -> naranja
        color_bad      = "#cc241d"   # crítico    -> rojo
}

order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

volume master {
        format = "󰕾 %volume"
        format_muted = "󰖁 %volume"
        device = "pulse"
        min_width = "󰕾 100%"
        align = "left"
}

wireless _first_ {
        format_up = "󰖩 %essid%quality"
        format_down = "󰖪"
}

# Sin cable no imprime nada. separator/separator_block_width a 0 evitan
# que el bloque vacio deje un "·" y un hueco sueltos en la barra.
ethernet _first_ {
        format_up = "󰈀 %ip"
        format_down = ""
        separator = false
        separator_block_width = 0
}

battery all {
        format = "%status %percentage %remaining"
        format_percentage = "%.00f%s"
        status_chr  = "󰂄"
        status_bat  = "󰁹"
        status_unk  = "󰂑"
        status_full = "󰁹"
        low_threshold = 15
        threshold_type = percentage
        min_width = "󰂄 100% 00:00"
        align = "left"
}

disk "/" {
        format = "󰋊 %avail"
        low_threshold = 10
        threshold_type = percentage_avail
}

load {
        format = "󰘚 %1min"
        min_width = "󰘚 00.00"
        align = "left"
}

memory {
        format = "󰍛 %used"
        format_degraded = "󰍛 %used (%available)"
        threshold_degraded = "1G"
        min_width = "󰍛 00.0 GiB"
        align = "left"
}

tztime local {
        format = "󰅐 %Y-%m-%d %H:%M"
}
