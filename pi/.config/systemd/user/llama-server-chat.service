[Unit]
Description=llama.cpp server (Qwen3-4B, chat/shortcuts)
Documentation=https://github.com/ggml-org/llama.cpp
After=network.target

[Service]
Type=simple
# gen.nvim (<espacio>a) y los atajos de shell (ai/cmd/why/gitai).
# --reasoning off: Qwen3 piensa por defecto y con max_tokens pequeño se gastaba
# el presupuesto en el razonamiento oculto -> respuesta vacía.
# -c 4096 + KV en q8_0: el KV cache de Qwen3-4B cuesta ~144 KiB/token en f16.
# A 12288 eran ~1.7 GiB residentes; 4096 cubre de sobra gen.nvim y los atajos
# de shell, y cuantizar K/V a q8_0 lo vuelve a partir por la mitad.
ExecStart=~/llama.cpp/build/bin/llama-server \
  --model ~/models/Qwen3-4B-Q4_K_M.gguf \
  --alias qwen3-4b \
  --host 127.0.0.1 --port 8083 \
  --ctx-size 4096 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --threads 4 \
  --parallel 1 \
  --n-predict 512 \
  --jinja \
  --reasoning off
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
