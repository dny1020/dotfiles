[Unit]
Description=llama.cpp server (Qwen2.5-Coder-1.5B)
After=network.target

[Service]
Type=simple
# -fa on + --cache-reuse: el FIM de las extensiones reenvía el mismo contexto (ring)
# en cada pulsación; con cache-reuse el server hace KV-shift en vez de reprocesarlo.
ExecStart=/home/jnarvaar/llama.cpp/build/bin/llama-server -m /home/jnarvaar/models/Qwen2.5-Coder-1.5B-Instruct-Q4_K_M.gguf --host 0.0.0.0 --port 8082 -t 4 -c 16384 -np 1 -n 512 -fa on -b 2048 -ub 1024 --cache-reuse 256
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
