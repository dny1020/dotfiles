[Unit]
Description=llama.cpp server (Qwen3-4B GGUF) for the pi coding agent
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/home/jnarvaar/llama.cpp/build/bin/llama-server \
  --model /home/jnarvaar/models/Qwen3-4B-Q4_K_M.gguf \
  --alias qwen3-4b \
  --host 127.0.0.1 --port 8080 \
  --ctx-size 16384 \
  --threads 8 \
  --jinja \
  --chat-template-kwargs '{"enable_thinking": false}'
Restart=on-failure
RestartSec=3
# Qwen3-4B emits proper <tool_call> JSON so pi's tools (read/edit/write/bash) work.
# thinking is disabled for CPU speed; remove --chat-template-kwargs to re-enable it.
# Model stays resident in RAM (~3GB) while the service is active.

[Install]
WantedBy=default.target
