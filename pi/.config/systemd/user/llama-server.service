[Unit]
Description=llama.cpp server (Qwen2.5-Coder-1.5B-Instruct)
After=network.target

[Service]
Type=simple
# Servidor unico: FIM/autocompletado (nvim minuet, llama-vscode) y chat/acciones
# (gen.nvim, helpers de zsh, apps locales de prueba). Qwen2.5-Coder-1.5B hace FIM
# nativo y sirve de instruct decente; se cambio desde el 7B por RAM/velocidad
# en este WSL de 20GB (el 7B iba a ~3-4 tok/s y era pesado en memoria).
# -fa on + --cache-reuse: las extensiones reenvian el mismo contexto (ring) en
# cada pulsacion; con cache-reuse el server hace KV-shift en vez de reprocesarlo.
# Solo loopback por defecto: el portatil se conecta a wifis ajenas. En WSL los
# clientes llegan por la IP de la VM, asi que ahi ~/.config/llama-server.env
# (no versionado) pone LLAMA_BIND=0.0.0.0.
Environment=LLAMA_BIND=127.0.0.1
EnvironmentFile=-%h/.config/llama-server.env
ExecStart=%h/llama.cpp/build/bin/llama-server -m %h/models/Qwen2.5-Coder-1.5B-Instruct-Q4_K_M.gguf --host ${LLAMA_BIND} --port 8082 -t 8 -c 16384 -np 1 -n 768 -fa on -b 2048 -ub 512 --cache-reuse 256
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
