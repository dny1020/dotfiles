#!/usr/bin/env bash
# Start llama-server (llama.cpp) serving the local coding model for pi.
# OpenAI-compatible API on http://127.0.0.1:8080  (pi reads llamaServerUrl from ~/.pi/agent/settings.json)
# Usage: llama-serve [extra llama-server args...]
set -euo pipefail

LLAMA_BIN="${LLAMA_BIN:-$HOME/llama.cpp/build/bin/llama-server}"
MODEL="${LLAMA_MODEL:-$HOME/models/Qwen3-4B-Q4_K_M.gguf}"
HOST="${LLAMA_HOST:-127.0.0.1}"
PORT="${LLAMA_PORT:-8080}"
CTX="${LLAMA_CTX:-8192}"        # raise to 16384 if RAM allows
THREADS="${LLAMA_THREADS:-$(nproc)}"

[ -x "$LLAMA_BIN" ] || { echo "llama-server not found at $LLAMA_BIN" >&2; exit 1; }
[ -f "$MODEL" ]     || { echo "model not found at $MODEL" >&2; exit 1; }

exec "$LLAMA_BIN" \
  --model "$MODEL" \
  --host "$HOST" --port "$PORT" \
  --ctx-size "$CTX" \
  --threads "$THREADS" \
  --jinja \
  "$@"
