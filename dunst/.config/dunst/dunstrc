[global]
    monitor = 0
    follow = mouse
    width = 340
    height = (0, 130)
    origin = top-right
    offset = (12, 12)
    scale = 0
    notification_limit = 5

    # osd.sh ya dibuja el nivel con bloques en el titulo, en amarillo.
    # La barra nativa de dunst duplicaba ese dato y ademas venia en azul,
    # su color por defecto compilado (ni este archivo ni /etc/xdg lo fijaban).
    progress_bar = false

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#d79921"
    separator_color = frame
    sort = yes

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b><span foreground='#d79921'>%s</span></b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 0
    max_icon_size = 48

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# Fondos con alfa (#rrggbbaa) para que picom los difumine, igual que la barra.
# Un poco mas opacos que la barra (cc = 80%) porque una notificacion se
# superpone a ventanas con contenido, no solo al wallpaper.
[urgency_low]
    background = "#1d2021cc"
    foreground = "#a89984"
    frame_color = "#504945"
    timeout = 2

[urgency_normal]
    background = "#1d2021cc"
    foreground = "#ebdbb2"
    frame_color = "#d79921"
    timeout = 6

[urgency_critical]
    background = "#1d2021e6"
    foreground = "#ebdbb2"
    frame_color = "#cc241d"
    timeout = 0
